{
	"name": "code-office",
	"displayName": "code-office",
	"description": "Local HWP/HWPX editing and cross-format document review in VS Code.",
	"version": "3.7.49",
	"publisher": "jun6161",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/lidge-jun/code-office.git"
	},
	"homepage": "https://lidge-jun.github.io/code-office/",
	"bugs": {
		"url": "https://github.com/lidge-jun/code-office/issues"
	},
	"icon": "images/logo-new.png",
	"engines": {
		"vscode": "^1.64.0"
	},
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Document preview and markdown editing are available in untrusted workspaces. File write operations still require explicit user action."
		}
	},
	"keywords": [
		"hwp",
		"hwpx",
		"hangul",
		"korean",
		"office",
		"pdf",
		"word",
		"markdown",
		"notes",
		"xlsx",
		"excel",
		"rhwp",
		"document",
		"review"
	],
	"categories": [
		"Visualization",
		"Other"
	],
	"galleryBanner": {
		"color": "#111318",
		"theme": "dark"
	},
	"activationEvents": [
		"onStartupFinished",
		"onCustomEditor:cweijan.officeViewer",
		"onCustomEditor:cweijan.docxEditor",
		"onCustomEditor:cweijan.pptxEditor",
		"onCustomEditor:cweijan.hwpEditor",
		"onCustomEditor:cweijan.imageViewer",
		"onCustomEditor:cweijan.markdownViewer",
		"onCustomEditor:cweijan.markdownViewer.optional",
		"onCustomEditor:cweijan.htmlViewer"
	],
	"main": "./out/extension.js",
	"contributes": {
		"themes": [
			{
				"label": "One Dark Modern",
				"uiTheme": "vs-dark",
				"path": "./theme/onedark-modern.json"
			},
			{
				"label": "One Dark Modern Classic",
				"uiTheme": "vs-dark",
				"path": "./theme/onedark-modern-classic.json"
			}
		],
		"languages": [
			{
				"id": "reg",
				"aliases": [
					"REG",
					"reg"
				],
				"extensions": [
					".reg",
					".REG"
				],
				"configuration": "./syntaxes/reg-language-configuration.json"
			},
			{
				"id": "http",
				"aliases": [
					"HTTP",
					"Http",
					"http"
				],
				"extensions": [
					".http",
					".rest"
				],
				"firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE)\\s+(.*?)HTTP/[0-9\\.]+$",
				"configuration": "./syntaxes/http-language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "reg",
				"scopeName": "source.reg",
				"path": "./syntaxes/reg.tmLanguage"
			},
			{
				"language": "http",
				"scopeName": "source.http",
				"path": "./syntaxes/http.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "http",
				"path": "./snippets/http.json"
			}
		],
		"commands": [
			{
				"command": "office.quickOpen",
				"title": "Quick open",
				"category": "ShortcutMenuBar",
				"icon": "$(files)"
			},
			{
				"command": "vscode-office.save-response-body",
				"title": "Save Response",
				"icon": "$(save)"
			},
			{
				"command": "vscode-office.copy-response-body",
				"title": "Copy Response",
				"icon": "$(copy)"
			},
			{
				"command": "office.reg.jumpToKey",
				"title": "REG: Jump to registry key"
			},
			{
				"command": "office.markdown.switch",
				"title": "Switch markdown editor",
				"icon": {
					"dark": "./images/switch.svg",
					"light": "./images/switch_light.svg"
				}
			},
			{
				"command": "office.markdown.paste",
				"title": "Enhance paste in markdown"
			},
			{
				"command": "office.html.preview",
				"title": "Preview HTML"
			},
			{
				"command": "code-office.previewLegacyPresentation",
				"title": "Preview Legacy PowerPoint with LibreOffice"
			},
			{
				"command": "code-office.hwp.save",
				"title": "Save HWP/HWPX Document",
				"category": "code-office"
			},
			{
				"command": "code-office.docx.save",
				"title": "Save DOCX Document",
				"category": "code-office"
			},
			{
				"command": "code-office.hwp.switchToViewer",
				"title": "HWP/HWPX: Switch to Viewer",
				"category": "code-office",
				"icon": "$(eye)"
			},
			{
				"command": "code-office.hwp.switchToEditor",
				"title": "HWP/HWPX: Switch to Editor",
				"category": "code-office",
				"icon": "$(edit)"
			},
			{
				"command": "code-office.hwp.exportSvg",
				"title": "HWP/HWPX: Export SVG Pages",
				"category": "code-office"
			},
			{
				"command": "code-office.hwp.exportPdf",
				"title": "HWP/HWPX: Save as PDF",
				"category": "code-office"
			},
			{
				"command": "code-office.hwp.debugOverlay",
				"title": "HWP/HWPX: Show Debug Overlay",
				"category": "code-office"
			},
			{
				"command": "code-office.hwp.dumpParagraph",
				"title": "HWP/HWPX: Dump Paragraph",
				"category": "code-office"
			}
		],
		"keybindings": [
			{
				"command": "code-office.hwp.save",
				"key": "ctrl+s",
				"mac": "cmd+s",
				"when": "activeCustomEditorId == cweijan.hwpEditor"
			},
			{
				"command": "code-office.docx.save",
				"key": "ctrl+s",
				"mac": "cmd+s",
				"when": "activeCustomEditorId == cweijan.docxEditor"
			},
			{
				"command": "office.markdown.paste",
				"key": "ctrl+v",
				"mac": "cmd+v",
				"when": "!terminalFocus && !filesExplorerFocus && resourceLangId == markdown"
			},
			{
				"command": "office.html.preview",
				"key": "ctrl+shift+v",
				"when": "editorTextFocus && editorLangId == html"
			},
			{
				"command": "office.markdown.switch",
				"key": "ctrl+alt+e",
				"mac": "ctrl+cmd+e",
				"when": "editorTextFocus && editorLangId == markdown"
			},
			{
				"command": "vscode-office.request",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorTextFocus && editorLangId == 'http'"
			}
		],
		"menus": {
			"editor/title": [
				{
					"when": "config.vscode-office.quickOpen",
					"command": "office.quickOpen",
					"group": "navigation@10"
				},
				{
					"command": "office.markdown.switch",
					"when": "resourceExtname == '.md'",
					"group": "navigation@-2"
				},
				{
					"command": "code-office.hwp.switchToViewer",
					"when": "activeCustomEditorId == cweijan.hwpEditor",
					"group": "navigation@1"
				},
				{
					"command": "code-office.hwp.switchToEditor",
					"when": "activeCustomEditorId == cweijan.hwpEditor",
					"group": "navigation@2"
				},
				{
					"command": "code-office.hwp.exportSvg",
					"when": "activeCustomEditorId == cweijan.hwpEditor",
					"group": "navigation@3"
				},
				{
					"command": "code-office.hwp.debugOverlay",
					"when": "activeCustomEditorId == cweijan.hwpEditor",
					"group": "navigation@4"
				},
				{
					"command": "code-office.hwp.dumpParagraph",
					"when": "activeCustomEditorId == cweijan.hwpEditor",
					"group": "navigation@5"
				},
				{
					"when": "editorTextFocus && resourceScheme == rest-client-response",
					"command": "vscode-office.copy-response-body",
					"group": "navigation@0"
				},
				{
					"when": "editorTextFocus && resourceScheme == rest-client-response",
					"command": "vscode-office.save-response-body",
					"group": "navigation@2"
				}
			],
			"editor/context": [
				{
					"command": "office.html.preview",
					"group": "navigation@1",
					"when": "editorTextFocus && editorLangId == html"
				},
				{
					"command": "vscode-office.save-response-body",
					"group": "http@2",
					"when": "editorTextFocus && resourceScheme == rest-client-response"
				},
				{
					"command": "vscode-office.copy-response-body",
					"group": "http@4",
					"when": "editorTextFocus && resourceScheme == rest-client-response"
				}
			],
			"explorer/context": [
				{
					"command": "code-office.previewLegacyPresentation",
					"group": "navigation",
					"when": "resourceExtname == '.ppt'"
				},
				{
					"command": "code-office.hwp.exportSvg",
					"group": "code-office-hwp@1",
					"when": "resourceExtname == '.hwp' || resourceExtname == '.hwpx'"
				},
				{
					"command": "code-office.hwp.debugOverlay",
					"group": "code-office-hwp@2",
					"when": "resourceExtname == '.hwp' || resourceExtname == '.hwpx'"
				},
				{
					"command": "code-office.hwp.dumpParagraph",
					"group": "code-office-hwp@3",
					"when": "resourceExtname == '.hwp' || resourceExtname == '.hwpx'"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "cweijan.officeViewer",
				"displayName": "code-office Office Viewer",
				"selector": [
					{
						"filenamePattern": "*.xlsx"
					},
					{
						"filenamePattern": "*.xlsm"
					},
					{
						"filenamePattern": "*.csv"
					},
					{
						"filenamePattern": "*.xls"
					},
					{
						"filenamePattern": "*.ods"
					},
					{
						"filenamePattern": "*.pdf"
					},
					{
						"filenamePattern": "*.ttf"
					},
					{
						"filenamePattern": "*.woff"
					},
					{
						"filenamePattern": "*.woff2"
					},
					{
						"filenamePattern": "*.otf"
					},
					{
						"filenamePattern": "*.jar"
					},
					{
						"filenamePattern": "*.zip"
					},
					{
						"filenamePattern": "*.rar"
					},
					{
						"filenamePattern": "*.apk"
					},
					{
						"filenamePattern": "*.vsix"
					},
					{
						"filenamePattern": "*.svg"
					}
				]
			},
			{
				"viewType": "cweijan.docxEditor",
				"displayName": "DOCX Editor (code-office)",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.docx"
					},
					{
						"filenamePattern": "*.dotx"
					}
				]
			},
			{
				"viewType": "cweijan.pptxEditor",
				"displayName": "PPTX Viewer (code-office)",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.pptx"
					},
					{
						"filenamePattern": "*.pptm"
					},
					{
						"filenamePattern": "*.ppsx"
					}
				]
			},
			{
				"viewType": "cweijan.hwpEditor",
				"displayName": "HWP/HWPX Editor (code-office)",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.hwp"
					},
					{
						"filenamePattern": "*.hwpx"
					}
				]
			},
			{
				"viewType": "cweijan.imageViewer",
				"displayName": "Image Preview (code-office)",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.jpg"
					},
					{
						"filenamePattern": "*.png"
					},
					{
						"filenamePattern": "*.gif"
					},
					{
						"filenamePattern": "*.apng"
					},
					{
						"filenamePattern": "*.bmp"
					},
					{
						"filenamePattern": "*.ico"
					},
					{
						"filenamePattern": "*.cur"
					},
					{
						"filenamePattern": "*.jpeg"
					},
					{
						"filenamePattern": "*.pjpeg"
					},
					{
						"filenamePattern": "*.pjp"
					},
					{
						"filenamePattern": "*.tif"
					},
					{
						"filenamePattern": "*.webp"
					}
				]
			},
			{
				"viewType": "cweijan.markdownViewer",
				"displayName": "Markdown Notes Editor",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.md"
					},
					{
						"filenamePattern": "*.markdown"
					}
				]
			},
			{
				"viewType": "cweijan.markdownViewer.optional",
				"displayName": "Markdown Notes Editor (Legacy Compatibility)",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.md"
					},
					{
						"filenamePattern": "*.markdown"
					}
				]
			},
			{
				"viewType": "cweijan.htmlViewer",
				"displayName": "HTML Viewer",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.html"
					},
					{
						"filenamePattern": "*.htm"
					}
				]
			}
		],
		"configuration": {
			"type": "object",
			"title": "code-office",
			"properties": {
				"vscode-office.quickOpen": {
					"title": "Quick open",
					"type": "boolean",
					"default": false,
					"description": "show icon for Go to File, 'Quick Open'"
				},
				"vscode-office.viewAbsoluteLocal": {
					"type": "boolean",
					"default": false,
					"description": "Support view absolute path image from markdown viewer."
				},
				"vscode-office.chromiumPath": {
					"type": "string",
					"description": "Set the chromium browser location for exporting markdown pdf."
				},
				"vscode-office.pdfMarginTop": {
					"type": "integer",
					"default": 25,
					"description": "Printed pdf default top margin."
				},
				"vscode-office.editorMode": {
					"type": "string",
					"enum": [
						"wysiwyg",
						"ir",
						"sv",
						"raw"
					],
					"enumDescriptions": [
						"What You See Is What You Get (WYSIWYG editing)",
						"Instant Rendering (inline preview while editing)",
						"Split View (edit on left, preview on right)",
						"Raw Markdown Source inside the Code Office webview"
					],
					"default": "ir",
					"description": "Default editing mode for the Markdown editor. 'ir' (Instant Rendering) gives an Obsidian Live Preview-like experience; 'raw' opens a raw Markdown source surface inside the Code Office webview."
				},
				"vscode-office.openOutline": {
					"type": "boolean",
					"default": true,
					"description": "Open markdown outline."
				},
				"vscode-office.hideToolbar": {
					"type": "boolean",
					"default": false,
					"description": "Hide markdown toolbar."
				},
				"vscode-office.previewCode": {
					"type": "boolean",
					"default": true,
					"description": "Preview code in markdown."
				},
				"vscode-office.preventMacOptionKey": {
					"type": "boolean",
					"default": true,
					"description": "Prevent MacOS option key in the markdown editor."
				},
				"vscode-office.editorTheme": {
					"type": "string",
					"enum": [
						"Auto",
						"Light",
						"Solarized"
					],
					"default": "Light",
					"markdownDescription": "The theme for the Markdown editor."
				},
				"vscode-office.previewCodeHighlight.style": {
					"type": "string",
					"enum": [
						"abap",
						"algol",
						"algol_nu",
						"arduino",
						"autumn",
						"borland",
						"bw",
						"colorful",
						"dracula",
						"emacs",
						"friendly",
						"fruity",
						"github",
						"igor",
						"lovelace",
						"manni",
						"monokai",
						"monokailight",
						"murphy",
						"native",
						"paraiso-dark",
						"paraiso-light",
						"pastie",
						"perldoc",
						"pygments",
						"rainbow_dash",
						"rrt",
						"solarized-dark",
						"solarized-dark256",
						"solarized-light",
						"swapoff",
						"tango",
						"trac",
						"vim",
						"vs",
						"xcode",
						"ant-design"
					],
					"default": "dracula",
					"markdownDescription": "Default syntax highlight style of markdown preview code. Refer to [Chroma Style Gallery](https://xyproto.github.io/splash/docs/longer/all.html). Only applies when `#vscode-office.previewCode#` is enabled."
				},
				"vscode-office.previewCodeHighlight.showLineNumber": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Show line numbers in markdown preview code window. Only applies when `#vscode-office.previewCode#` is enabled."
				},
				"vscode-office.editorLanguage": {
					"type": "string",
					"enum": [
						"en_US",
						"ja_JP",
						"ko_KR",
						"ru_RU",
						"zh_CN",
						"zh_TW"
					],
					"default": "en_US",
					"description": "You could change your editor language."
				},
				"vscode-office.workspacePathAsImageBasePath": {
					"type": "boolean",
					"default": false,
					"description": "Using workspace path as markdown image base path."
				},
				"vscode-office.pptx.libreOfficePath": {
					"type": "string",
					"default": "",
					"description": "LibreOffice executable path for optional legacy .ppt PDF preview."
				},
				"vscode-office.pptx.conversionTimeoutMs": {
					"type": "integer",
					"default": 30000,
					"minimum": 1000,
					"description": "LibreOffice legacy .ppt conversion timeout in milliseconds."
				},
				"code-office.hwp.experimentalSave": {
					"type": "boolean",
					"default": true,
					"description": "Show the HWP/HWPX toolbar save button. VS Code native save remains available for dirty custom editor documents."
				},
				"code-office.hwp.studioUrl": {
					"type": "string",
					"default": "",
					"description": "Optional trusted remote rhwp studio URL. Leave empty to use the bundled local rhwp-studio with full HWP/HWPX editing."
				},
				"vscode-office.pasterImgPath": {
					"type": "string",
					"default": "image/${fileName}/${now}.png",
					"description": "Markdown paste image path, variables: workspaceDir, fileName, now."
				}
			}
		}
	},
	"scripts": {
		"dev": "vite --mode=development",
		"audit:phase06": "node scripts/audit-phase06-1.mjs",
		"audit:phase06-1": "node scripts/audit-phase06-1.mjs",
		"lint:fix": "eslint src/**/*.ts --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/react/tsconfig.json",
		"build": "rm -rf out && vite build --mode=production",
		"test:wikilink-parser": "node src/test/wikilinkParserTest.mjs",
		"test:wikilink-phase3": "node src/test/wikilinkPhase3Test.mjs",
		"test:wikilink-authoring": "node src/test/wikilinkAuthoringTest.mjs",
		"test:wikilink-resolver": "node src/test/wikilinkResolverTest.mjs",
		"test:docx-editor-provider": "node src/test/docxEditorProviderTest.mjs",
		"test:pptx-phase4": "node src/test/pptxPhase4Test.mjs",
		"test:markdown-phase5": "node src/test/markdownPhase5Test.mjs",
		"test:markdown-live-raw": "node src/test/markdownLiveRawTest.mjs",
		"test:markdown-commonjs-boundary": "node src/test/markdownCommonjsBoundaryTest.mjs",
		"test:markdown": "npm run test:wikilink-parser && npm run test:wikilink-phase3 && npm run test:wikilink-authoring && npm run test:wikilink-resolver && npm run test:markdown-phase5 && npm run test:markdown-live-raw && npm run test:markdown-commonjs-boundary",
		"test:excel-phase6": "node src/test/excelPhase6Test.mjs",
		"test:hwp-viewer-mode": "node src/test/hwpViewerModeTest.mjs",
		"test:office": "npm run test:pptx-phase4 && npm run test:excel-phase6 && npm run test:hwp-viewer-mode && npm run test:docx-editor-provider",
		"test:security": "npm run audit:phase06",
		"test:ci": "npm run test:markdown && npm run test:office && npm run test:security",
		"test:hwp-hardening": "node scripts/verify-hwp-hardening.mjs && node scripts/verify-hwp-compatibility-matrix.mjs",
		"verify:hwp": "node scripts/verify-hwp-hardening.mjs",
		"verify:hwp-compatibility": "node scripts/verify-hwp-compatibility-matrix.mjs",
		"build:rhwp-native-pdf": "node scripts/build-rhwp-native-pdf.mjs",
		"verify:vsix": "node scripts/verify-vsix.mjs --vsix",
		"verify:release": "npm run typecheck && npm run test:ci && npm run build && npm run build:rhwp-native-pdf && npm run verify:hwp && npm run verify:hwp-compatibility && node scripts/verify-vsix.mjs",
		"smoke": "npm run release:local",
		"package": "vsce package --no-dependencies",
		"package:openvsx": "node scripts/package-openvsx.mjs",
		"package:verify": "npm run build:rhwp-native-pdf && npm run package && npm run verify:vsix",
		"release:local": "npm run verify:release && npm run package:verify",
		"publish": "npm run release:local && vsce publish --no-dependencies",
		"publish:openvsx": "node scripts/publish-openvsx.mjs",
		"vscode:prepublish": "npm run build && npm run verify:hwp"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.0",
		"@types/node": "^22.10.0",
		"@types/react": "^18.2.66",
		"@types/react-dom": "^18.2.22",
		"@types/vscode": "^1.64.0",
		"@typescript-eslint/eslint-plugin": "^7.1.1",
